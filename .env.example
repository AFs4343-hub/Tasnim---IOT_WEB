# Salin menjadi .env.local (sudah di-.gitignore) lalu isi dari
# Firebase Console → Project settings → General → Your apps (Web app).
# Nilai konfigurasi web Firebase bukan password, tetapi JANGAN commit .env.local.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=omirisetmonitoring.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://omirisetmonitoring-default-rtdb.asia-southeast1.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=omirisetmonitoring
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Opsional ---
# Sumber data awal website: hardware_test (default) atau simulation.
# Tombol "Data Alat / Simulasi" di website tetap bisa dipakai kapan saja.
# VITE_TASNIM_DATA_SOURCE=hardware_test

# Website membuat sesi Firebase anonim otomatis (tanpa form login) agar
# Rules "auth != null" bisa membaca hardware_test. Set NO untuk mematikan.
# VITE_TASNIM_ANON_AUTH=YES

# Koordinat node untuk peta (lat,lng desimal), contoh:
# VITE_TASNIM_NODE_COORDS=N0:0.5512,123.0601;N1:0.5520,123.0610;N2:0.5530,123.0590

# Hanya untuk uji lokal dengan Firebase Auth Emulator:
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
