{
  "rules": {
    ".read": false,
    ".write": false,

    "simulation": {
      ".read": true,
      ".write": false
    },

    "hardware_test": {
      ".read": "auth != null",
      ".write": "auth != null"
    },

    "field": {
      "nodes": {
        ".read": true,

        "$node": {
          "latest": {
            ".write": "auth != null && ($node === 'N0' || $node === 'N1' || $node === 'N2')",

            ".validate": "newData.hasChildren(['ph', 'tds', 'timestamp'])",

            "ph": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
            },

            "tds": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "turbidity": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },

            "sequence": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "rssi": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      },

      "history": {
        ".read": true,

        "$slot": {
          "$node": {
            ".write": "auth != null && ($node === 'N0' || $node === 'N1' || $node === 'N2')",

            ".validate": "newData.hasChildren(['ph', 'tds', 'timestamp'])",

            "ph": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 14"
            },

            "tds": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "turbidity": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },

            "sequence": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "rssi": {
              ".validate": "newData.isNumber()"
            }
          }
        }
      },

      "analysis": {
        ".read": true,
        ".write": false
      },

      "metadata": {
        ".read": "auth != null",

        "$node": {
          "location": {
            ".write": "auth != null && ($node === 'N0' || $node === 'N1' || $node === 'N2')",

            ".validate": "newData.hasChildren(['latitude', 'longitude'])",

            "latitude": {
              ".validate": "newData.isNumber() && newData.val() >= -90 && newData.val() <= 90"
            },

            "longitude": {
              ".validate": "newData.isNumber() && newData.val() >= -180 && newData.val() <= 180"
            },

            "captured_timestamp": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },

            "satellites": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            },

            "hdop": {
              ".validate": "newData.isNumber() && newData.val() >= 0"
            }
          }
        }
      },

      "system": {
        "nodes": {
          ".read": true,

          "$node": {
            ".write": "auth != null && ($node === 'N0' || $node === 'N1' || $node === 'N2')",

            "last_seen": {
              ".validate": "newData.isNumber() && newData.val() > 0"
            },

            "time_source": {
              ".validate": "newData.isString()"
            },

            "rtc_ok": {
              ".validate": "newData.isBoolean()"
            },

            "gps_ok": {
              ".validate": "newData.isBoolean()"
            },

            "sd_ok": {
              ".validate": "newData.isBoolean()"
            },

            "wifi_rssi": {
              ".validate": "newData.isNumber()"
            },

            "firmware_version": {
              ".validate": "newData.isString()"
            }
          }
        }
      }
    }
  }
}
